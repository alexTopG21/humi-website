      <div><dt data-i18n="ct_lang">Languages</dt><dd data-i18n="ct_lang_v">Japanese, English, French</dd></div>
      <div><dt data-i18n="ct_loc">Location</dt><dd data-i18n="ct_loc_v">Fukuoka, Japan</dd></div>
    </dl>
  </div>
</section>
