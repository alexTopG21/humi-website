        <div><h2>{{ post.data.title }}</h2>{% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}</div>
      </a></li>
      {% endfor %}
    </ul>
    {% endif %}
    <p class="parts-note"><a href="/blog/" data-i18n="art_all">All articles</a> · <a href="/ja/blog/" lang="ja">日本語の記事</a></p>
  </div>
</section>

