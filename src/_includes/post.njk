---
layout: base.njk
pageType: blog
---
<article class="post">
  <div class="wrap">
    <div class="inner" lang="{{ lang or 'en' }}">
      <a class="back" href="/blog/">Back to the blog</a>
      <h1>{{ title }}</h1>
      <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      <div class="prose">
        {{ content | safe }}
      </div>
    </div>
    <p class="cta inner">Looking for a Japanese part? <a href="/#quote">Request a quote</a> and we'll reply within one to two business days.</p>
  </div>
</article>
