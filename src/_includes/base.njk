<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} | {{ site.name }}{% else %}HUMI | Quality checks for robot training video{% endif %}</title>
<meta name="description" content="{{ description or 'HUMI checks first-person and robot-camera training video for darkness, blur, camera shake, hands out of frame and faces, and tells you which clips to keep. Runs on your own servers in Japan.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if translation %}<link rel="alternate" hreflang="{{ 'en' if lang == 'ja' else 'ja' }}" href="{{ site.url }}{{ translation }}">{% endif %}
{% if pageType == 'home' %}<link rel="alternate" hreflang="en" href="{{ site.url }}/"><link rel="alternate" hreflang="ja" href="{{ site.url }}/ja/">{% endif %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{% if pageType == 'home' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.name }}",
  "alternateName": "Humanoid Industries",
  "url": "{{ site.url }}/",
  "logo": "{{ site.url }}/logo.png",
  "email": "{{ site.email }}"
}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v={{ buildId }}">
</head>
<body data-page="{{ pageType or 'page' }}" data-email="{{ site.email }}"{% if lang == 'ja' %} data-fixed-lang="ja"{% endif %}>

<header class="top">
  <div class="wrap">
    {% if lang == 'ja' %}
    <a class="wordmark" href="/ja/" aria-label="HUMI ホーム">HUM<span class="i" aria-hidden="true"></span></a>
    <nav aria-label="メイン">
      <a class="link" href="/ja/#product">製品</a>
      <a class="link" href="/ja/#how">仕組み</a>
      <a class="link" href="/ja/blog/"{% if pageType == 'blog' %} aria-current="page"{% endif %}>リサーチ</a>
      <a class="link" href="/ja/#contact">お問い合わせ</a>
      <div class="lang" role="group" aria-label="言語">
        <a href="/?lang=en" lang="en">EN</a>
        <a href="/?lang=fr" lang="fr">FR</a>
        <span class="on" aria-current="true">日本語</span>
      </div>
      <a class="btn small" href="/ja/#pilot">試験導入を相談</a>
    </nav>
    {% else %}
    <a class="wordmark" href="/" aria-label="HUMI home">HUM<span class="i" aria-hidden="true"></span></a>
    <nav aria-label="Main">
      <a class="link" href="/#product" data-i18n="nav_product">Product</a>
      <a class="link" href="/#how" data-i18n="nav_how">How it works</a>
      <a class="link" href="/blog/" data-i18n="nav_research"{% if pageType == 'blog' %} aria-current="page"{% endif %}>Research</a>
      <a class="link" href="/#contact" data-i18n="nav_contact">Contact</a>
      <div class="lang" role="group" aria-label="Language">
        <button type="button" data-lang="en" aria-pressed="true">EN</button>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
        <a href="/ja/" lang="ja">日本語</a>
      </div>
      <a class="btn small" href="/#pilot" data-i18n="nav_cta">Request a pilot</a>
    </nav>
    {% endif %}
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="HUMI home">HUM<span class="i" aria-hidden="true"></span></a>
    <div>
      {% if lang == 'ja' %}
      <p>HUMI（Humanoid Industries）個人事業／福岡</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>本サイトに記載の会社名・製品名は各社の商標または登録商標であり、識別の目的でのみ使用しています。</p>
      <div id="privacy">
        <h3>プライバシーポリシー</h3>
        <p>お問い合わせでいただいた情報は、ご返信と、ご同意いただいた試験導入のためにのみ使用します。第三者に販売・提供することはありません。試験導入で共有いただいた動画はその目的にのみ使用し、ご希望に応じて削除します。訂正や削除のご希望は、いつでもご連絡ください。</p>
      </div>
      {% else %}
      <p data-i18n="foot_biz">HUMI (Humanoid Industries), sole proprietorship, Fukuoka, Japan</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p data-i18n="foot_disc">Company and product names mentioned on this site belong to their owners and are used only for identification.</p>
      <div id="privacy">
        <h3 data-i18n="priv_h">Privacy policy</h3>
        <p data-i18n="priv_p">We use the information you send only to answer your request and run pilots you agree to. We don't sell or share it. Video you share with us for a pilot is used only for that pilot and deleted afterwards on request. Write to us anytime to correct or delete your data.</p>
      </div>
      {% endif %}
      <p>© <span class="yr">2026</span> HUMI</p>
    </div>
  </div>
</footer>
<script src="/js/site.js?v={{ buildId }}"></script>
</body>
</html>
